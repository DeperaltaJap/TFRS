@{
    Layout = "_Layout";
    ViewData["Title"] = "Tricycle Franchise Records";
}

@section Styles {
    <link rel="stylesheet" href="~/css/records.css" />
}

<div class="container my-4">

    <div class="card border-0 shadow-lg records-card">

        <!-- HEADER -->
        <div class="card-header records-header">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div class="d-flex align-items-center gap-3">

                    <img src="~/images/seal.png"
                         class="header-logo"
                         alt="Seal" />

                    <div>
                        <h4 class="mb-0 fw-bold">
                            TRICYCLE FRANCHISE SYSTEM
                        </h4>
                        <small class="text-muted">
                            Archives & Records Section
                        </small>
                    </div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('#masterlist table button').forEach(function (btn) {
            btn.addEventListener('click', async function (e) {
                var row = e.target.closest('tr');
                if (!row) return;
                var franchise = row.cells[2].innerText.trim();
                if (!franchise) return;

                try {
                    const res = await fetch('/Records/GetByFranchise?id=' + encodeURIComponent(franchise));
                    if (!res.ok) throw new Error('Not found');
                    const data = await res.json();

                    // populate fields
                    document.querySelector('.info-card .box') && (document.querySelector('.info-card .box').innerText = data.DateSubmitted || '');
                    // populate specific fields by selectors (simplified)
                    document.querySelectorAll('.info-card .box')[1] && (document.querySelectorAll('.info-card .box')[1].innerText = data.TricycleFranchiseNumber || '');
                    // fill middle panel
                    // For brevity, update a few selectors; extend as needed
                    document.querySelectorAll('.info-card + .info-card .box')[0] && (document.querySelectorAll('.info-card + .info-card .box')[0].innerText = data.DateIssued || '');
                }
                catch (err) {
                    console.error(err);
                    alert('Unable to load record');
                }
            });
        });
    });
</script>

                </div>

                <a class="btn btn-dark px-4"
                   asp-controller="Home"
                   asp-action="Index">
                    ⬅ BACK
                </a>

            </div>

            <!-- SEARCH BAR -->
            <div class="mt-3 search-bar">

                <label class="fw-bold me-2">KEYWORDS:</label>

                <input type="text" class="form-control search-input" />

                <button class="btn btn-primary">Search</button>
                <button class="btn btn-warning text-white">History</button>
                <button class="btn btn-success">C.O.F</button>

            </div>

        </div>

        <!-- BODY -->
        <div class="card-body">

            <div class="row g-4">

                <!-- LEFT PANEL -->
                <div class="col-lg-5">

                    <div class="info-card">

                        <h6 class="section-title">Operator Information</h6>

                        <div class="field">
                            <span>Date Submitted</span>
                            <div class="box"></div>
                        </div>

                        <div class="field">
                            <span>Franchise No</span>
                            <div class="box danger"></div>
                        </div>

                        <div class="field">
                            <span>Name</span>
                            <div class="box"></div>
                        </div>

                        <div class="field">
                            <span>Address</span>
                            <div class="box small">
                                
                            </div>
                        </div>

                        <div class="field">
                            <span>Chassis No</span>
                            <div class="box"></div>
                        </div>

                        <div class="field">
                            <span>Engine No</span>
                            <div class="box"></div>
                        </div>

                        <div class="field">
                            <span>Plate No</span>
                            <div class="box"></div>
                        </div>

                    </div>

                </div>

                <!-- MIDDLE PANEL -->
                <div class="col-lg-5">

                    <div class="info-card">

                        <h6 class="section-title"></h6>

                        <div class="field">
                            <span>Date Issued</span>
                            <div class="box"></div>
                        </div>

                        <div class="field">
                            <span>Date Expired</span>
                            <div class="box danger"></div>
                        </div>

                        <div class="field">
                            <span>TODA</span>
                            <div class="box"></div>
                        </div>

                        <div class="field">
                            <span>Status</span>
                            <div class="box status"></div>
                        </div>

                        <div class="field">
                            <span>Remarks</span>
                            <div class="box danger-text">
                               
                            </div>
                        </div>

                        <div class="field">
                            <span>Route Covered</span>
                            <div class="box small">
                                
                            </div>
                        </div>

                    </div>

                </div>

                <!-- RIGHT PANEL -->
                <div class="col-lg-2">

                    <div class="photo-card">

                        <div class="photo-box">
                            <span>PHOTO</span>
                        </div>

                    </div>

                    <button class="btn btn-primary w-100 mt-3">
                        VIEW PICTURE
                    </button>

                </div>

            </div>
            <!-- Masterlist -->
            <hr class="my-4" />
            <div id="masterlist" class="mt-3">
                <h5 class="mb-3">Masterlist</h5>
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover table-sm">
                        <thead class="table-light">
                            <tr>
                                <th style="width:4%">#</th>
                                <th>Name</th>
                                <th style="width:12%">Franchise No.</th>
                                <th style="width:10%">TODA</th>
                                <th style="width:12%">Route</th>
                                <th style="width:10%">Color</th>
                                <th style="width:10%">Status</th>
                                <th style="width:12%">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.MainRecords != null)
                            {
                                var __records = ViewBag.MainRecords as IEnumerable<TFRS.Models.MainTableRecord>;
                                if (__records != null)
                                {
                                    int __i = 1;
                                    foreach (var __r in __records)
                                    {
                                        <tr>
                                            <td>@__i</td>
                                            <td>@__r.NameOfOperator</td>
                                            <td>@__r.TricycleFranchiseNumber</td>
                                            <td>@__r.TODA</td>
                                            <td>@__r.RouteCovered</td>
                                            <td>@__r.Color</td>
                                            <td>
                                                @{
                                                    var __status = (__r.Status ?? "").ToString();
                                                    if (string.Equals(__status, "Active", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <text><span class="badge bg-success">Active</span></text>
                                                    }
                                                    else if (string.Equals(__status, "Pending", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <text><span class="badge bg-warning text-dark">Pending</span></text>
                                                    }
                                                    else
                                                    {
                                                        <text><span class="badge bg-secondary">@__status</span></text>
                                                    }
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <button class="btn btn-sm btn-outline-primary">View</button>
                                                    <button class="btn btn-sm btn-outline-secondary">Edit</button>
                                                </div>
                                            </td>
                                        </tr>
                                        __i++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-muted">No records available</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-muted">No records available</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- FOOTER -->
        <div class="card-footer text-end small text-muted">
            Designed and Developed by: IT Team
        </div>

    </div>

</div>